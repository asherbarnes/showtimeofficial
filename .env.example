# Copy to .env.local. Both are optional; leave unset for local and staging builds.

# Final canonical origin, e.g. https://www.example.com — NOT decided yet (CONTENT_NEEDED B7).
# When unset: no canonical URLs, no metadataBase, and an empty sitemap.
SITE_URL=

# Set to "true" only for the production launch build. Anything else emits
# robots.txt "Disallow: /" and a noindex meta tag on every page.
ALLOW_INDEXING=
